<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BrewOS · Daily Close</title><style>
:root{--g:#143D2B;--d:#0D2F21;--o:#F26C21;--p:#FFFDF9;--c:#F7E9D6;--m:#6b756f}*{box-sizing:border-box}body{margin:0;font-family:Arial,'Noto Sans Thai',sans-serif;background:var(--p);color:var(--d)}header{padding:24px 5vw;background:linear-gradient(120deg,var(--d),var(--g));color:#fff}h1{margin:0;font-size:24px}.sub{opacity:.72;margin-top:4px}.wrap{max-width:1100px;margin:auto;padding:24px}.bar,.grid,.payments{display:grid;gap:14px}.bar{grid-template-columns:1fr auto}.grid{grid-template-columns:repeat(4,1fr);margin:18px 0}.payments{grid-template-columns:repeat(4,1fr)}.card{background:#fff;border:1px solid #eadfce;border-radius:16px;padding:16px;box-shadow:0 4px 18px #143d2b0b}.label{font-size:12px;color:var(--m)}.value{font-size:24px;font-weight:700;margin-top:6px}.btn{border:0;background:var(--o);color:#fff;padding:12px 18px;border-radius:10px;font-weight:700;cursor:pointer}.btn:disabled{opacity:.45}.input{width:100%;padding:11px;border:1px solid #d8d4cc;border-radius:10px;font-size:16px;margin-top:6px}.ok{color:#177a45}.bad{color:#b42318}.note{font-size:13px;color:var(--m);margin-top:12px}.topnav{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.topnav a{color:#fff;text-decoration:none;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);padding:8px 12px;border-radius:10px;font-size:13px}.topnav a.active{background:var(--o);border-color:var(--o)}.topnav a:hover{background:rgba(255,255,255,.15)}
@media(max-width:800px){.grid,.payments{grid-template-columns:1fr 1fr}.bar{grid-template-columns:1fr}}@media(max-width:500px){.grid,.payments{grid-template-columns:1fr}}</style></head><body>
<header><h1>Daily Close & Reconciliation</h1><div class="sub">BrewOS · Brain Brew × Heng Heng</div><nav class="topnav"><a href="dashboard.html">Dashboard</a><a href="finance.html">Finance</a><a class="active" href="daily_close.html">Daily Close</a></nav></header><div class="wrap">
<div class="bar"><input id="date" class="input" type="date"><button class="btn" onclick="loadPreview()">โหลดสรุปวันนี้</button></div>
<div id="status" class="note">กำลังโหลด…</div><div id="kpi" class="grid"></div>
<div class="card"><h3>ยอดตามช่องทางรับเงิน</h3><div class="payments" id="payments"></div><div class="note">กรอก “ยอดรับจริง” จากเงินสด/QR/โอน ณ ตอนปิดวัน ระบบจะเทียบกับยอดที่ POS บันทึกไว้</div></div>
<div class="card" style="margin-top:16px"><label class="label">หมายเหตุ</label><input id="notes" class="input" placeholder="เช่น QR ต่าง 1 บาทจากค่าธรรมเนียม / เงินทอน"><button id="closeBtn" class="btn" style="margin-top:14px" onclick="closeDay()">ปิดยอดวันนี้</button><div id="result" class="note"></div></div>
</div><script src="api.js"></script>
<script>
let P=null;
const fmt=n=>'฿'+Number(n||0).toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});
function today(){return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Bangkok'}).format(new Date())}
document.getElementById('date').value=today();
function k(label,v){return `<div class="card"><div class="label">${label}</div><div class="value">${v}</div></div>`}
async function loadPreview(){
  document.getElementById('status').textContent='กำลังโหลด…';
  try{
    P=await API.dailyClosePreview(date.value);
    kpi.innerHTML=k('Net Sales',fmt(P.net_sales))+k('COGS',fmt(P.cogs))+k('Gross Profit',fmt(P.gross_profit))+k('Net Profit',fmt(P.net_profit))+k('Tickets',P.ticket_count)+k('Low Stock',P.low_stock_count)+k('Negative Stock',P.negative_stock_count)+k('Integrity Errors',P.unresolved_integrity_events);
    const e=P.expected_payment||{};
    payments.innerHTML=['cash','qr','transfer','other'].map(x=>`<div><div class="label">${x.toUpperCase()} · expected ${fmt(e[x])}</div><input id="a_${x}" class="input" type="number" step="0.01" value="${Number(e[x]||0)}"></div>`).join('');
    status.innerHTML=P.can_close?'<span class="ok">พร้อมปิดยอด</span>':'<span class="bad">ยังปิดไม่ได้: มี Integrity Error</span>';
    closeBtn.disabled=!P.can_close;
  }catch(err){
    status.innerHTML='<span class="bad">'+(err.message||'โหลดข้อมูลไม่สำเร็จ')+'</span>';
    closeBtn.disabled=true;
  }
}
async function closeDay(){
  if(!P)return;
  closeBtn.disabled=true; result.textContent='กำลังปิดยอด…';
  try{
    const data=await API.closeDay({date:P.date,actual_cash:a_cash.value,actual_qr:a_qr.value,actual_transfer:a_transfer.value,actual_other:a_other.value,notes:notes.value,closed_by:'owner'});
    if(!data?.success){result.innerHTML='<span class="bad">'+(data?.error||'Close failed')+'</span>';closeBtn.disabled=false;return}
    const v=data.variance||{}; result.innerHTML=`<span class="ok">ปิดยอดแล้ว ${data.close_id}</span> · variance รวม ${fmt(v.total||0)}`;
  }catch(err){
    result.innerHTML='<span class="bad">'+(err.message||'Close failed')+'</span>'; closeBtn.disabled=false;
  }
}
loadPreview();
</script></body></html>
